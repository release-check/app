{
  "name": "app",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/release-check/app.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck",
    "bench:public-search": "bun run scripts/bench-public-search.ts",
    "bench:search": "bun run scripts/bench-search.ts",
    "build:index": "bun run scripts/build-index.ts",
    "demo-data": "bun run scripts/demo-data.ts",
    "dev:demo": "bun run scripts/dev-demo.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "eval:core": "bun run scripts/eval-core-bridge.ts",
    "eval:demo": "bun run scripts/eval-demo.ts",
    "eval:verified": "bun run scripts/eval-verified.ts",
    "test": "bun test",
    "test:public-contract": "bun run scripts/test-public-contract.ts",
    "validate:provenance": "bun run scripts/validate-provenance.ts",
    "rc:search": "bun run scripts/rc-cli.ts search",
    "rc:availability": "bun run scripts/rc-cli.ts availability",
    "rc:resolve": "bun run scripts/rc-cli.ts resolve",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck && bun run --cwd packages/rc-sdk-js typecheck"
  }
}
